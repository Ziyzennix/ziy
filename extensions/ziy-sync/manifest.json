{
  "manifest_version": 3,
  "name": "Ziy Sync",
  "version": "1.0.0",
  "description": "Ziy's sync chain: an end-to-end encrypted copy of your own data, on a server that cannot read it. No accounts, no emails, no passwords.",
  "author": "Ziy",
  "browser_specific_settings": {
    "gecko": {
      "id": "ziy-sync@ziy.app",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "scripts": ["background/background.js"],
    "persistent": false,
    "type": "module"
  },
  "permissions": [
    "storage",
    "nativeMessaging",
    "bookmarks",
    "history",
    "tabs"
  ],
  "optional_permissions": [],
  "host_permissions": [],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Ziy Sync",
    "default_icon": {
      "16": "icons/ziy-sync-16.png",
      "32": "icons/ziy-sync-32.png",
      "48": "icons/ziy-sync-48.png"
    }
  },
  "icons": {
    "16": "icons/ziy-sync-16.png",
    "32": "icons/ziy-sync-32.png",
    "48": "icons/ziy-sync-48.png",
    "96": "icons/ziy-sync-96.png"
  }
}
