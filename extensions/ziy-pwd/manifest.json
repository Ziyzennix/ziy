{
  "manifest_version": 3,
  "name": "Ziy Passwords",
  "version": "1.0.0",
  "description": "Ziy's password manager: a credential vault held by a native helper, encrypted under a passphrase only you hold.",
  "author": "Ziy",
  "homepage_url": "https://ziy.app",
  "browser_specific_settings": {
    "gecko": {
      "id": "ziy-pwd@ziy.app",
      "strict_min_version": "142.0"
    }
  },
  "background": {
    "scripts": ["lib/pwd-client.js", "background/background.js"],
    "type": "classic"
  },
  "permissions": [
    "storage",
    "nativeMessaging",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [],
  "action": {
    "default_title": "Ziy Passwords",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/key-16.png",
      "32": "icons/key-32.png",
      "48": "icons/key-48.png"
    }
  },
  "icons": {
    "16": "icons/key-16.png",
    "32": "icons/key-32.png",
    "48": "icons/key-48.png",
    "96": "icons/key-96.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui/*",
        "lib/*",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
