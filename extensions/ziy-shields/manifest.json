{
  "manifest_version": 3,
  "name": "Ziy Shields",
  "version": "1.0.0",
  "description": "Ziy's blocking engine: ad, tracker and fingerprint protection with per-site controls.",
  "author": "Ziy",
  "homepage_url": "https://ziy.app",
  "browser_specific_settings": {
    "gecko": {
      "id": "ziy-shields@ziy.app",
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "declarativeNetRequest",
    "nativeMessaging",
    "webRequest",
    "webRequestBlocking",
    "webNavigation",
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "lib/filterlist/parser.js",
      "lib/filterlist/lists.js",
      "lib/engine/store.js",
      "lib/engine/precedence.js",
      "lib/engine/dnr-compile.js",
      "lib/engine/blocking.js",
      "lib/engine/counter.js",
      "lib/engine/static-match.js",
      "lib/engine/residual-index.js",
      "lib/engine/cosmetic.js",
      "lib/engine/spotify-adslot.js",
      "background/background.js"
    ],
    "service_worker": "background/background.js",
    "type": "classic"
  },
  "action": {
    "default_title": "Ziy Shields",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "icons/shield-16.png",
      "32": "icons/shield-32.png",
      "48": "icons/shield-48.png",
      "96": "icons/shield-96.png"
    }
  },
  "options_page": "ui/options.html",
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/cosmetic.js",
        "content/spotify-adslot.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
"declarative_net_request": {},
  "web_accessible_resources": [
    {
      "resources": [
        "ui/*",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/shield-16.png",
    "32": "icons/shield-32.png",
    "48": "icons/shield-48.png",
    "96": "icons/shield-96.png"
  }
}
