[Desktop Entry]
Type=Application
Name=Ziy
GenericName=Web Browser
Comment=Ziy — a privacy-first browser on the Gecko engine
Exec=/usr/bin/ziy %u
TryExec=/usr/bin/ziy
Icon=ziy
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Terminal=false
StartupNotify=true
StartupWMClass=Ziy
Keywords=browser;web;internet;ziy;shield;privacy;
Actions=new-window;new-private-window;profile-manager;

[Desktop Action new-window]
Name=New Window
Exec=/usr/bin/ziy --new-window

[Desktop Action new-private-window]
Name=New Private Window
Exec=/usr/bin/ziy --private-window

[Desktop Action profile-manager]
Name=Profiles
Exec=/usr/bin/ziy --ProfileManager
